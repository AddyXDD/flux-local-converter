{
  "name": "flux-local-converter",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -Variant online",
    "desktop:build:offline": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -Variant offline",
    "build:context-menu": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-context-menu.ps1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@vitejs/plugin-react": "latest",
    "docx": "^9.15.4",
    "docx-preview": "^0.4.1",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "lucide-react": "latest",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "^7.0.0",
    "typescript": "latest",
    "vite": "latest",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@microsoft/winappcli": "^0.8.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
